# === User Configuration Section: Only modify these variables ===
VERSION="1.5.8"
RELEASE_DATE="2026-09-23"
HOME_PAGE="https://gpumdkit.cn"
CONTACT="yanzihan@westlake.edu.cn"

# New features (one per line, in an array; keep at most the five newest entries)
NEW_FEATURES=(
    "add web MD monitor for neighbor.out radial/angular actual-vs-max traces, run.in step progress, speed, and ETA"
    "add sandboxed web-console file actions: home and parent navigation, create, upload, and download"
    "add context-aware web plot actions for RDF, XRD, cohesive energy, viscosity, phonon bands, and force errors"
    "add -server web console: one content canvas per directory, conditional sections, adaptive monitoring, chart scale controls, web terminal, conflict-safe file editing"
    "add --save-data TAB-separated export for EMD, NEMD, and HNEMD plot data"
)

# Bug fixes (one per line, in an array; keep at most the five newest entries)
BUG_FIXES=(
    "refresh changed server-console images from scan metadata and cache-bust only updated image URLs"
    "refine the server console UI with a flat, minimal card design and clearer action cards: input-file hints, colored generated/stale/not-generated status pills, and per-action chart icons"
    "rework the server training workspace with continuous generation axes for resumed loss logs, nep.in parameter context, and compact desktop action cards"
    "refresh growing loss.out data in the server console and pass GPUMDkit_path to allowlisted plot actions"
    "capture path and sequence per loss request so late responses cannot draw into another directory"
)

# === Formatted Output Logic ===

# Check if terminal supports colors
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    # Colorized output
    printf "\033[1;36m      ✨ GPUMDkit Update Information ✨       \033[0m\n"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;32mVersion:\033[0m %s\n" "$VERSION"
    printf "\033[1;32mRelease Date:\033[0m %s\n" "$RELEASE_DATE"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\n\033[1;33m🚀 What's New:\033[0m\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\n\033[1;33m🔧 Bug Fixes:\033[0m\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "\n\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;35m🏠 HomePage:\033[0m %s\n" "$HOME_PAGE"
    printf "\033[1;36m📧 Contact:\033[0m %s\n" "$CONTACT"
else
    # Plain text output (no colors, simple symbols)
    printf "GPUMDKit Update Information\n"
    printf "----------------------------------------------\n"
    printf "Version: %s\n" "$VERSION"
    printf "Release Date: %s\n" "$RELEASE_DATE"
    printf "----------------------------------------------\n"
    printf "\nWhat's New:\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\nBug Fixes:\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "----------------------------------------------\n"
    printf "\nHomePage: %s\n" "$HOME_PAGE"
    printf "Contact: %s\n" "$CONTACT"
fi
