# === User Configuration Section: Only modify these variables ===
VERSION="1.5.7"
RELEASE_DATE="2026-08-23"
HOME_PAGE="https://gpumdkit.cn"
CONTACT="yanzihan@westlake.edu.cn"

# New features (one per line, in an array)
NEW_FEATURES=(
    "add -prediction for Calorine NEP .out predictions with optional CPU parallelism"
    "add -xyz2dp"
    "add perturb.txt report for structure perturbation"
    "add -plt emd2 for EMD thermal conductivity in all directions"
    "add -plt D_PT and -plt sigma_PT for phase-transition piecewise Arrhenius fits"
    "add -plt xrd_comp for stacked XRD comparison across temperature folders"
)

# Bug fixes (one per line, in an array)
BUG_FIXES=(
    "align -prediction stress/virial conversions with the NEP sign convention and add tqdm progress"
    "replace outdated automated active-learning guidance with a manual MD/FPS workflow"
    "fix thermo3 volume and lattice-angle axis offset display"
    "fix signed HAC and zero-direction handling in -plt emd2"
    "preserve the requested element order in -xyz2dp type_map.raw output"
    "reject mismatched q-point paths in -plt phonon_comp"
    "correct plotting documentation, -plt xrd completion, and output filename text inconsistencies"
)

# === Formatted Output Logic ===

# Check if terminal supports colors
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    # Colorized output
    printf "\033[1;36m      ✨ GPUMDkit Update Information ✨       \033[0m\n"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;32mVersion:\033[0m %s\n" "$VERSION"
    printf "\033[1;32mRelease Date:\033[0m %s\n" "$RELEASE_DATE"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\n\033[1;33m🚀 What's New:\033[0m\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\n\033[1;33m🔧 Bug Fixes:\033[0m\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "\n\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;35m🏠 HomePage:\033[0m %s\n" "$HOME_PAGE"
    printf "\033[1;36m📧 Contact:\033[0m %s\n" "$CONTACT"
else
    # Plain text output (no colors, simple symbols)
    printf "GPUMDKit Update Information\n"
    printf "----------------------------------------------\n"
    printf "Version: %s\n" "$VERSION"
    printf "Release Date: %s\n" "$RELEASE_DATE"
    printf "----------------------------------------------\n"
    printf "\nWhat's New:\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\nBug Fixes:\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "----------------------------------------------\n"
    printf "\nHomePage: %s\n" "$HOME_PAGE"
    printf "Contact: %s\n" "$CONTACT"
fi
