# === User Configuration Section: Only modify these variables ===
VERSION="1.5.8"
RELEASE_DATE="2026-09-23"
HOME_PAGE="https://gpumdkit.cn"
CONTACT="yanzihan@westlake.edu.cn"

# New features (one per line, in an array; keep at most the five newest entries)
NEW_FEATURES=(
    "convert legacy xyz.in to model.xyz automatically for EMD, NEMD, and HNEMD post-processing"
    "add optional --quantum SHC correction to NEMD and HNEMD while retaining classical spectra"
    "convert LAMMPS data files, including compressed ones, with -lmp2exyz"
    "add Tab filename completion and line editing at interactive-mode input prompts"
    "add -time wpe progress monitoring for WPE-enabled GPUMD runs with buffered updates"
)

# Bug fixes (one per line, in an array; keep at most the five newest entries)
BUG_FIXES=(
    "plot NEP loss curves with actual generations, custom output intervals, and restarted training histories"
    "read both legacy numeric and header-prefixed nep.restart files in the restart plot"
    "preserve complete out2xyz Config_type metadata for paths containing spaces or quotes"
    "accept fractional NEMD time_step values and write NPZ/TXT data only with --save-data"
    "select the right active.xyz frames in menu 205 (select_max_modev.py) when GPUMD saved only frames above its active threshold"
)

# === Formatted Output Logic ===

# Check if terminal supports colors
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    # Colorized output
    printf "\033[1;36m      ✨ GPUMDkit Update Information ✨       \033[0m\n"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;32mVersion:\033[0m %s\n" "$VERSION"
    printf "\033[1;32mRelease Date:\033[0m %s\n" "$RELEASE_DATE"
    printf "\033[1;34m----------------------------------------------\033[0m\n"
    printf "\n\033[1;33m🚀 What's New:\033[0m\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\n\033[1;33m🔧 Bug Fixes:\033[0m\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "\n\033[1;34m----------------------------------------------\033[0m\n"
    printf "\033[1;35m🏠 HomePage:\033[0m %s\n" "$HOME_PAGE"
    printf "\033[1;36m📧 Contact:\033[0m %s\n" "$CONTACT"
else
    # Plain text output (no colors, simple symbols)
    printf "GPUMDKit Update Information\n"
    printf "----------------------------------------------\n"
    printf "Version: %s\n" "$VERSION"
    printf "Release Date: %s\n" "$RELEASE_DATE"
    printf "----------------------------------------------\n"
    printf "\nWhat's New:\n"
    for feature in "${NEW_FEATURES[@]}"; do
        printf "  - %s\n" "$feature"
    done
    printf "\nBug Fixes:\n"
    for fix in "${BUG_FIXES[@]}"; do
        printf "  - %s\n" "$fix"
    done
    printf "----------------------------------------------\n"
    printf "\nHomePage: %s\n" "$HOME_PAGE"
    printf "Contact: %s\n" "$CONTACT"
fi
